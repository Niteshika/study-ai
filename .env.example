# ---- LLM: openai | gemini | fake (fake = offline, tests only)
LLM_PROVIDER=openai
# On EC2: leave the keys empty and set APP_SECRET_ID instead (keys are read from Secrets Manager)
OPENAI_API_KEY=
GEMINI_API_KEY=
# APP_SECRET_ID=study-ai/app

# ---- Database (RDS Postgres + pgvector)
# Your laptop: the full URL. Get the password from Secrets Manager (the rds!db-... secret).
DATABASE_URL=postgresql://postgres:PASSWORD@YOUR-ENDPOINT.ap-south-1.rds.amazonaws.com:5432/studyai?sslmode=require
# On EC2 you can leave DATABASE_URL out and use these instead (password read from Secrets Manager):
# DB_SECRET_ID=rds!db-xxxxxxxx
# DB_HOST=YOUR-ENDPOINT.ap-south-1.rds.amazonaws.com
AWS_REGION=ap-south-1

# ---- Uploads. Leave empty to keep files in DATA_DIR/uploads instead of S3.
S3_BUCKET=
DATA_DIR=data

# ---- Server
# Your domain, once you have one (protects the /mcp endpoint). Leave empty locally.
PUBLIC_HOST=
# Create tables when the server starts (1 = yes)
INIT_DB_ON_START=1

# ---- Retrieval settings
MATCH_THRESHOLD=0.5
MAX_FILE_MB=50
# RETRIEVAL_STUB=1
# CURRICULUM_FAKE=1

# ---- Tests only: a LOCAL database that tests are allowed to wipe. Never your RDS.
TEST_DATABASE_URL=postgresql://postgres:pw@localhost:5432/studyai_test
